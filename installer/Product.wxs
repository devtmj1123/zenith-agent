<?xml version="1.0" encoding="UTF-8"?>
<!--
  Zenith-OS WiX Installer Definition
  Build: candle Product.wxs && light Product.wixobj -o Zenith-OS.msi
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="Zenith-OS"
           Language="1033"
           Version="1.0.0.0"
           Manufacturer="ApeironAI"
           UpgradeCode="a1b2c3d4-e5f6-7890-abcd-ef1234567890">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="Zenith-OS Personal AI Agent Operating System"
             Comments="Built by ApeironAI" />

    <MajorUpgrade DowngradeErrorMessage="A newer version is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!-- Features -->
    <Feature Id="ProductFeature" Title="Zenith-OS" Level="1">
      <ComponentGroupRef Id="ProductComponents" />
      <ComponentRef Id="ApplicationShortcut" />
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <Feature Id="DesktopShortcutFeature" Title="Desktop Shortcut" Level="1">
      <ComponentRef Id="DesktopShortcut" />
    </Feature>

    <!-- UI -->
    <UIRef Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

    <!-- Icon -->
    <Icon Id="ZenithIcon" SourceFile="icon.ico" />
    <Property Id="ARPPRODUCTICON" Value="ZenithIcon" />

    <!-- License -->
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />
  </Product>

  <!-- Directory Structure -->
  <Fragment>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFilesFolder">
        <Directory Id="INSTALLFOLDER" Name="Zenith-OS">
          <Directory Id="AppDir" Name="app">
            <Directory Id="StaticDir" Name="static" />
            <Directory Id="TemplatesDir" Name="templates" />
          </Directory>
          <Directory Id="ConfigDir" Name="config" />
          <Directory Id="SkillsDir" Name="skills" />
          <Directory Id="CoreDir" Name="core" />
          <Directory Id="MemoryDir" Name="memory" />
          <Directory Id="ToolsDir" Name="tools" />
          <Directory Id="ResearchDir" Name="research" />
          <Directory Id="FiltersDir" Name="filters" />
          <Directory Id="SandboxDir" Name="sandbox" />
          <Directory Id="TtsDir" Name="tts" />
          <Directory Id="InstallerDir" Name="installer" />
        </Directory>
      </Directory>

      <!-- Start Menu -->
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="Zenith-OS" />
      </Directory>

      <!-- Desktop -->
      <Directory Id="DesktopFolder" Name="Desktop" />
    </Directory>
  </Fragment>

  <!-- Components -->
  <Fragment>
    <ComponentGroup Id="ProductComponents" Directory="INSTALLFOLDER">

      <!-- Main executable -->
      <Component Id="MainExe" Guid="*">
        <File Id="ZenithOS.exe" Source="dist\Zenith-OS\Zenith-OS.exe" KeyPath="yes" />
      </Component>

      <!-- Python DLLs and libraries -->
      <Component Id="PythonLibs" Guid="*">
        <File Id="python3.dll" Source="dist\Zenith-OS\python3.dll" />
        <File Id="python313.dll" Source="dist\Zenith-OS\python313.dll" />
      </Component>

      <!-- Application files -->
      <Component Id="AppFiles" Guid="*">
        <File Id="InitPy" Source="dist\Zenith-OS\app\__init__.py" />
        <File Id="MainPy" Source="dist\Zenith-OS\app\main.py" />
        <File Id="ServerPy" Source="dist\Zenith-OS\app\server.py" />
      </Component>

      <!-- Static files -->
      <Component Id="StaticFiles" Guid="*">
        <File Id="StyleCSS" Source="dist\Zenith-OS\app\static\style.css" />
        <File Id="AppJS" Source="dist\Zenith-OS\app\static\app.js" />
      </Component>

      <!-- Templates -->
      <Component Id="TemplateFiles" Guid="*">
        <File Id="IndexHTML" Source="dist\Zenith-OS\app\templates\index.html" />
      </Component>

      <!-- Config -->
      <Component Id="ConfigFiles" Guid="*">
        <File Id="SettingsPy" Source="dist\Zenith-OS\config\settings.py" />
        <File Id="CodebookYaml" Source="dist\Zenith-OS\config\codebook.yaml" />
      </Component>

      <!-- Core modules -->
      <Component Id="CoreFiles" Guid="*">
        <File Id="AgentLoopPy" Source="dist\Zenith-OS\core\agent_loop.py" />
        <File Id="DesireEnginePy" Source="dist\Zenith-OS\core\desire_engine.py" />
        <File Id="UnrelatedAssocPy" Source="dist\Zenith-OS\core\unrelated_association.py" />
        <File Id="DreamControllerPy" Source="dist\Zenith-OS\core\dream_controller.py" />
      </Component>

      <!-- Zenith instructions -->
      <Component Id="ZenithMd" Guid="*">
        <File Id="ZenithMdFile" Source="dist\Zenith-OS\zenith.md" />
      </Component>

      <!-- License -->
      <Component Id="LicenseFile" Guid="*">
        <File Id="LicenseTxt" Source="dist\Zenith-OS\LICENSE" />
      </Component>
    </ComponentGroup>

    <!-- Start Menu Shortcut -->
    <DirectoryRef Id="ApplicationProgramsFolder">
      <Component Id="ApplicationShortcut" Guid="*">
        <Shortcut Id="ApplicationStartMenuShortcut"
                  Name="Zenith-OS"
                  Description="Zenith-OS Personal AI Agent"
                  Target="[INSTALLFOLDER]Zenith-OS.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ZenithIcon" />
        <RemoveFolder Id="CleanUpShortCut"
                      Directory="ApplicationProgramsFolder"
                      On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\Zenith-OS"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <!-- Desktop Shortcut -->
    <DirectoryRef Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="*">
        <Shortcut Id="DesktopApplicationShortcut"
                  Name="Zenith-OS"
                  Description="Zenith-OS Personal AI Agent"
                  Target="[INSTALLFOLDER]Zenith-OS.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="ZenithIcon" />
        <RegistryValue Root="HKCU"
                       Key="Software\Zenith-OS"
                       Name="desktop_shortcut"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </DirectoryRef>
  </Fragment>
</Wix>
